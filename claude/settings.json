      "Bash(which:*)",
      "Bash(whoami)",
      "Bash(whois:*)",
      "Bash(xxd:*)",
      "Bash(yq:*)",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Edit(**/tmp/**)",
      "Edit(/private/tmp/**)",
      "Edit(/tmp/**)",
      "Edit(/var/folders/**)",
      "Edit(tmp/**)",
      "Edit(~/.claude/**)",
      "Edit(~/Downloads/**)",
      "Edit(~/Projects/**)",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "Glob",
      "Grep",
      "LS",
      "Monitor",
      "NotebookEdit",
      "NotebookRead",
      "Read",
      "RemoteTrigger",
      "SendMessage",
      "Skill",
      "Task",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskStop",
      "TaskUpdate",
      "TeamCreate",
      "TeamDelete",
      "TodoWrite",
      "ToolSearch",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(* > /dev/disk*)",
      "Bash(* > /dev/sd*)",
      "Bash(awk * ~/.claude/.env)",
      "Bash(cat ~/.claude/.env)",
      "Bash(cat ~/.claude/.env.*)",
      "Bash(chmod -R 777 $HOME)",
      "Bash(chmod -R 777 /)",
      "Bash(chmod -R 777 ~)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(curl * | zsh)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(git push --force * main)",
      "Bash(git push --force * master)",
      "Bash(git push -f * main)",
      "Bash(git push -f * master)",
      "Bash(grep * ~/.claude/.env)",
      "Bash(head ~/.claude/.env)",
      "Bash(less ~/.claude/.env)",
      "Bash(mkfs*)",
      "Bash(od ~/.claude/.env)",
      "Bash(rg * ~/.claude/.env)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf ~/.claude)",
      "Bash(rm -rf ~/.claude/*)",
      "Bash(sed * ~/.claude/.env)",
      "Bash(tail ~/.claude/.env)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | zsh)",
      "Bash(xxd ~/.claude/.env)",
      "Edit(/System/**)",
      "Edit(/bin/**)",
      "Edit(/etc/**)",
      "Edit(/sbin/**)",
      "Edit(/usr/**)",
      "Edit(~/.claude/projects/**/memory/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.gnupg/private*)",
      "Read(~/.ssh/*_ed25519)",
      "Read(~/.ssh/*_rsa)",
      "Read(~/.ssh/id_*)",
      "Edit(~/.claude/BULIOS/MEMORY/STATE/Proof/receipts/**)",
      "Edit(~/.config/bulios/USER/MEMORY/STATE/Proof/receipts/**)",
      "Bash(ruby -e *)",
      "Bash(php -r *)",
      "Bash(*wrangler deploy *)",
      "Bash(*wrangler publish *)",
      "Bash(*wrangler rollback *)",
      "Bash(*wrangler versions upload *)",
      "Bash(*wrangler versions deploy *)",
      "Bash(*wrangler secret *)",
      "Bash(*wrangler secret:bulk *)",
      "Bash(*wrangler delete *)",
      "Bash(*wrangler pages deploy *)",
      "Bash(*wrangler pages publish *)",
      "Bash(*wrangler r2 bucket delete *)",
      "Bash(*wrangler d1 delete *)",
      "Bash(*wrangler kv namespace delete *)",
      "Bash(cf deploy *)",
      "Bash(cf * deploy *)",
      "Bash(cf * secret *)",
      "Bash(cf * publish *)",
      "Bash(cf * rollback *)",
      "Bash(dd-cli order submit *)",
      "Bash(dd-cli * order submit *)",
      "Edit(~/.claude/.git/hooks/**)",
      "Edit(~/.claude/.git/config)",
      "Edit(~/.config/bulios/USER/.git/hooks/**)",
      "Edit(~/.config/bulios/USER/.git/config)",
      "Edit(~/.local/state/bulios/sendgate/**)",
      "Read(~/.local/state/bulios/sendgate/**)",
      "Edit(~/.claude/BULIOS/MEMORY/STATE/function-hooks/**)",
      "Read(~/**/.env)",
      "Read(~/**/.env.local)",
      "Read(~/**/.env.dev)",
      "Read(~/**/.env.development)",
      "Read(~/**/.env.prod)",
      "Read(~/**/.env.production)",
      "Read(~/**/.env.bak)"
    ],
    "ask": [
      "Read(~/.claude/.env)",
      "Read(~/.claude/.env.*)",
      "Read(~/.claude/**/.env)",
      "Read(~/.claude/**/.env.*)",
      "Edit(~/.claude/.env)",
      "Edit(~/.claude/.env.*)",
      "Edit(~/.claude/**/.env)",
      "Edit(~/.claude/**/.env.*)",
      "mcp__plugin_slack_slack__slack_send_message",
      "mcp__plugin_slack_slack__slack_schedule_message",
      "Edit(~/.claude/**/*.py)",
      "Edit(~/.claude/settings.system.json)",
      "Edit(~/.config/bulios/USER/CONFIG/settings.user.json)"
    ],
    "additionalDirectories": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/AgentInvocation.hook.ts",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/TabState.hook.ts",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/EnvFileGuard.hook.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/AgentInvocation.hook.ts",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/TabState.hook.ts",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/PostToolObserver.hook.ts",
            "timeout": 35,
            "type": "command"
          },
          {
            "async": true,
            "command": "$HOME/.claude/hooks/EventLogger.hook.ts",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/WorkCompletionLearning.hook.ts"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/SessionCleanup.hook.ts"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/UpdateCounts.hook.ts"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/DocIntegrity.hook.ts"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/IntegrityCheck.hook.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ProjectWorkLog.hook.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/SessionTitle.hook.ts",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.claude/hooks/PromptProcessing.hook.ts",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.claude/hooks/SatisfactionCapture.hook.ts",
            "timeout": 20,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/VersionDrift.hook.ts",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/DriftReminder.hook.ts",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/MemoryTurnStart.hook.ts",
            "timeout": 20,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/AlgorithmNudge.hook.ts",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/TimeContext.hook.ts",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/VoiceMode.hook.ts",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/ModelDriftGuard.hook.ts",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/TurnRecord.hook.ts",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/EventLogger.hook.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/AlgorithmNudge.hook.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/EventLogger.hook.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bun $HOME/.claude/hooks/HookHealer.hook.ts",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "$HOME/.claude/hooks/KittyEnvPersist.hook.ts",
            "type": "command"
          },
          {
            "command": "$HOME/.claude/hooks/LoadContext.hook.ts",
            "type": "command"
          },
          {
            "async": true,
            "command": "bun $HOME/.claude/BULIOS/TOOLS/FreshnessCache.ts --quiet",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/LastResponseCache.hook.ts",
            "type": "command"
          },
          {
            "command": "$HOME/.claude/hooks/TabState.hook.ts",
            "type": "command"
          },
          {
            "async": true,
            "command": "$HOME/.claude/hooks/VoiceCompletion.hook.ts",
            "type": "command"
          },
          {
            "command": "$HOME/.claude/hooks/ISARenderOnStop.hook.ts",
            "type": "command"
          },
          {
            "command": "$HOME/.claude/hooks/StopGates.hook.ts",
            "type": "command"
          },
          {
            "command": "$HOME/.claude/hooks/MemoryReviewFire.hook.ts",
            "type": "command"
          },
          {
            "command": "$HOME/.claude/hooks/TurnOutcome.hook.ts",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.claude/hooks/MemoryHealthGate.hook.ts",
            "timeout": 15,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.claude/hooks/VigilTaskSummary.hook.ts",
            "timeout": 15,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/MemoryIndexRefresh.hook.ts",
            "timeout": 60,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/BlockerText.hook.ts",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/EventLogger.hook.ts"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/TabState.hook.ts"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/TabState.hook.ts",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/BlockerText.hook.ts",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/BULIOS/BULIOS_StatusLine.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": false,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voiceEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
