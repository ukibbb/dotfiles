# delta: readable diffs for git diff / show / log -p / add -p
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true        # n / N jump between files
	line-numbers = true
	side-by-side = false   # toggle with: git -c delta.side-by-side=true diff
	syntax-theme = Dracula

[diff]
	colorMoved = default
